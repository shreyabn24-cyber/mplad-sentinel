# ============================================================
# MPLADS Sentinel — .gitignore
# ============================================================

# ---- NEVER commit secrets ----
.env
.env.local
.env.production
.env.staging
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so
*.dylib
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
junit.xml
.tox/
.nox/
pip-log.txt
pip-delete-this-directory.txt

# ---- ML Artifacts ----
ml/models/saved/*.pkl
ml/models/saved/*.joblib
ml/models/saved/*.h5
ml/models/saved/*.pt
ml/models/saved/*.bin
mlruns/
mlartifacts/
*.mlmodel

# ---- Data Files (sensitive) ----
data/raw/
data/interim/
data/output/*.csv
data/output/*.json
!data/output/.gitkeep

# ---- Node / Next.js ----
node_modules/
.next/
out/
.vercel/
.netlify/
frontend/.next/
frontend/node_modules/
frontend/out/
*.tsbuildinfo
.turbo/

# ---- IDE & OS ----
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker ----
docker-compose.override.yml

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Temp ----
tmp/
temp/
.cache/
