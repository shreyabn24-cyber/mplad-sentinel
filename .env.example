# ============================================================
# MPLADS Sentinel — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://mplads:mplads_pass@localhost:5432/mplads_sentinel
DATABASE_SYNC_URL=postgresql://mplads:mplads_pass@localhost:5432/mplads_sentinel
POSTGRES_USER=mplads
POSTGRES_PASSWORD=mplads_pass
POSTGRES_DB=mplads_sentinel

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Neo4j (Contractor Graph) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mplads_neo4j_pass

# ---- MinIO (Object Storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mplads_minio
MINIO_SECRET_KEY=mplads_minio_secret
MINIO_BUCKET_SATELLITE=sentinel2-imagery
MINIO_BUCKET_CITIZEN=citizen-photos

# ---- Google Gemini API (Audit Note Generator) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ---- ESA Copernicus Hub (Sentinel-2 Satellite Data) ----
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASS=your_copernicus_password
COPERNICUS_API_URL=https://apihub.copernicus.eu/apihub

# ---- IMD Data API ----
IMD_API_KEY=your_imd_api_key

# ---- NewsAPI ----
NEWS_API_KEY=your_newsapi_key

# ---- JWT Authentication ----
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- App Settings ----
ENVIRONMENT=development
# Local synthetic accounts only. Keep false outside local development.
DEMO_MODE=false
# Set privately (12+ characters) only when DEMO_MODE=true, then run
# `python backend/seed_demo_users.py`. Never commit or publish this value.
DEMO_PASSWORD=
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ---- ML Settings ----
ISOLATION_FOREST_CONTAMINATION=0.05
CONFIDENCE_L1_THRESHOLD=30
CONFIDENCE_L2_THRESHOLD=55
CONFIDENCE_L3_THRESHOLD=75
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Scraping Settings ----
ESAKSHI_BASE_URL=https://mplads.nic.in
MGNREGA_MIS_URL=https://nrega.nic.in
SANSAD_URL=https://sansad.in
SCRAPE_DELAY_SECONDS=2
